# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne partagez jamais votre fichier .env — il contient des secrets.

PORT=3000

# Doit correspondre à l'adresse publique de votre serveur une fois déployé,
# suivie de /auth/google/callback (voir SETUP.md, étape Google).
APP_BASE_URL=http://localhost:3000

# --- Google (Gmail) — voir SETUP.md étape 1 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WhatsApp (Meta Cloud API) — voir SETUP.md étape 2 ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Chaîne inventée par vous, utilisée uniquement pour vérifier le webhook auprès de Meta.
WHATSAPP_VERIFY_TOKEN=

# --- Prospects Facebook / Instagram (Lead Ads) — voir SETUP.md étape 3 ---
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Chaîne inventée par vous, utilisée uniquement pour vérifier le webhook auprès de Meta.
FACEBOOK_LEADS_VERIFY_TOKEN=

# --- Statistiques publicitaires Facebook/Instagram (optionnel) ---
# Réutilise FACEBOOK_PAGE_ACCESS_TOKEN ci-dessus (ou FACEBOOK_ADS_ACCESS_TOKEN
# si vous préférez un jeton séparé avec la permission ads_read).
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_ADS_ACCESS_TOKEN=

# --- Récupération de compte ---
# Chaîne secrète inventée par vous. Permet de réinitialiser votre e-mail/mot
# de passe via l'écran "Mot de passe oublié ?" si vous êtes bloqué·e dehors.
# Gardez-la en lieu sûr (gestionnaire de mots de passe), ne la partagez jamais.
ADMIN_RESET_TOKEN=

# --- Stockage persistant (gratuit, recommandé en production) ---
# Base Upstash (Redis) — voir SETUP.md, section "Stockage persistant".
# Sans ces deux valeurs, MonCRM se replie sur un fichier local (data/), ce
# qui suffit pour tester mais est effacé à chaque redéploiement sur Render.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative payante à Upstash : chemin d'un disque persistant Render.
# Laissez vide si vous utilisez Upstash ci-dessus (inutile de faire les deux).
DATA_DIR=
